-- Clean The Library Minimum Working Version
-- No fancy UI, just works on Delta

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local running = false

-- CONFIG
local RANGE = 50
local SPEED = 16

-- STATE
local books = {}
local shelves = {}
local currentTarget = nil
local phase = "idle" -- toBook, collect, toShelf, place
local interactTimer = 0

-- HELPERS
local function getHRP()
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid()
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChildOfClass("Humanoid")
end

local function dist(pos)
    local hrp = getHRP()
    if not hrp then return 999 end
    return (hrp.Position - pos).Magnitude
end

-- SCAN
local function scan()
    books = {}
    shelves = {}
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("MeshPart") then
            local name = obj.Name
            
            if name:find("BookShelf") then
                local _, num = name:match("_(%d+)$")
                table.insert(shelves, {
                    Part = obj,
                    Num = tonumber(num) or 0,
                    Name = name
                })
            elseif name:match("_%d+$") then
                local bname, num = name:match("^(.+)_([%d]+)$")
                if bname then
                    table.insert(books, {
                        Part = obj,
                        Name = bname,
                        ShelfNum = tonumber(num) or 0,
                        FullName = name,
                        Done = false
                    })
                end
            end
        end
    end
    
    print(("📚 Found %d books, %d shelves"):format(#books, #shelves))
end

-- FIND SHELF FOR BOOK
local function findShelf(book)
    for _, s in ipairs(shelves) do
        if s.Num == book.ShelfNum then
            return s
        end
    end
    return shelves[1]
end

-- MOVE
local function moveToward(pos, stopAt)
    stopAt = stopAt or 4
    local hrp = getHRP()
    local hum = getHumanoid()
    if not hrp or not hum then return true end
    
    local target = Vector3.new(pos.X, hrp.Position.Y, pos.Z)
    local d = (target - hrp.Position).Magnitude
    
    if d <= stopAt then
        hum:Move(Vector3.new(), true)
        return true
    end
    
    local dir = (target - hrp.Position).Unit
    hum:Move(dir * SPEED, true)
    return false
end

-- INTERACT
local function interact(obj)
    if not obj or not obj.Parent then return false end
    
    local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt")
    if prompt then
        pcall(function()
            if fireproximityprompt then fireproximityprompt(prompt) end
        end)
        return true
    end
    
    local cd = obj:FindFirstChildWhichIsA("ClickDetector")
    if cd then
        pcall(function()
            if fireclickdetector then fireclickdetector(cd) end
        end)
        return true
    end
    
    return false
end

-- GET NEXT BOOK
local function getNextBook()
    for _, b in ipairs(books) do
        if not b.Done and b.Part and b.Part.Parent then
            return b
        end
    end
    return nil
end

-- MAIN LOOP
RunService.RenderStepped:Connect(function(dt)
    if not running then return end
    
    local hrp = getHRP()
    if not hrp then return end
    
    -- TO BOOK
    if phase == "toBook" then
        currentTarget = getNextBook()
        if not currentTarget then
            print("✅ All books done!")
            running = false
            phase = "idle"
            return
        end
        
        local arrived = moveToward(currentTarget.Part.Position, 5)
        if arrived then
            phase = "collect"
            interactTimer = 0
        end
        
    -- COLLECT
    elseif phase == "collect" then
        if not currentTarget or not currentTarget.Part or not currentTarget.Part.Parent then
            phase = "toBook"
            return
        end
        
        interactTimer = interactTimer + dt
        if interactTimer >= 0.5 then
            interact(currentTarget.Part)
            currentTarget.Done = true
            phase = "toShelf"
            interactTimer = 0
            print(("✅ Got: %s"):format(currentTarget.Name))
        end
        
    -- TO SHELF
    elseif phase == "toShelf" then
        local shelf = findShelf(currentTarget)
        if not shelf or not shelf.Part then
            phase = "toBook"
            return
        end
        
        local arrived = moveToward(shelf.Part.Position, 5)
        if arrived then
            phase = "place"
            interactTimer = 0
        end
        
    -- PLACE
    elseif phase == "place" then
        local shelf = findShelf(currentTarget)
        if shelf and shelf.Part and shelf.Part.Parent then
            interactTimer = interactTimer + dt
            if interactTimer >= 0.5 then
                interact(shelf.Part)
                print(("✅ Placed on shelf %d"):format(currentTarget.ShelfNum))
                phase = "toBook"
                interactTimer = 0
            end
        else
            phase = "toBook"
        end
    end
end)

-- CONTROLS
local function start()
    if running then return end
    scan()
    if #books == 0 then
        print("❌ No books found!")
        return
    end
    running = true
    phase = "toBook"
    print("🚀 Started!")
end

local function stop()
    running = false
    phase = "idle"
    local hum = getHumanoid()
    if hum then hum:Move(Vector3.new(), true) end
    print("⏹ Stopped")
end

-- SIMPLE UI (Minimal - Delta Compatible)
local function createUI()
    local gui = Instance.new("ScreenGui")
    gui.Name = "LibUI"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 200, 0, 120)
    frame.Position = UDim2.new(0.5, -100, 0, 50)
    frame.BackgroundColor3 = Color3.fromRGB(20, 20, 40)
    frame.BorderSizePixel = 0
    
    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 30)
    title.BackgroundColor3 = Color3.fromRGB(40, 30, 80)
    title.BorderSizePixel = 0
    title.Text = "📚 Library Auto"
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.TextSize = 14
    title.Font = Enum.Font.SourceSansBold
    
    local status = Instance.new("TextLabel")
    status.Size = UDim2.new(1, 0, 0, 20)
    status.Position = UDim2.new(0, 0, 0, 35)
    status.BackgroundTransparency = 1
    status.Text = "Status: Ready"
    status.TextColor3 = Color3.fromRGB(0, 255, 200)
    status.TextSize = 11
    status.Font = Enum.Font.SourceSans
    
    local startBtn = Instance.new("TextButton")
    startBtn.Size = UDim2.new(0.45, 0, 0, 30)
    startBtn.Position = UDim2.new(0.025, 0, 0, 60)
    startBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 80)
    startBtn.BorderSizePixel = 0
    startBtn.Text = "▶ START"
    startBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    startBtn.TextSize = 12
    startBtn.Font = Enum.Font.SourceSansBold
    
    local stopBtn = Instance.new("TextButton")
    stopBtn.Size = UDim2.new(0.45, 0, 0, 30)
    stopBtn.Position = UDim2.new(0.525, 0, 0, 60)
    stopBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    stopBtn.BorderSizePixel = 0
    stopBtn.Text = "⏹ STOP"
    stopBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    stopBtn.TextSize = 12
    stopBtn.Font = Enum.Font.SourceSansBold
    
    local scanBtn = Instance.new("TextButton")
    scanBtn.Size = UDim2.new(1, 0, 0, 25)
    scanBtn.Position = UDim2.new(0, 0, 0, 95)
    scanBtn.BackgroundColor3 = Color3.fromRGB(100, 80, 200)
    scanBtn.BorderSizePixel = 0
    scanBtn.Text = "🔄 SCAN"
    scanBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    scanBtn.TextSize = 11
    scanBtn.Font = Enum.Font.SourceSansBold
    
    -- PARENTS
    frame.Parent = gui
    title.Parent = frame
    status.Parent = frame
    startBtn.Parent = frame
    stopBtn.Parent = frame
    scanBtn.Parent = frame
    
    -- CLICKS
    startBtn.MouseButton1Click:Connect(function()
        start()
    end)
    
    stopBtn.MouseButton1Click:Connect(function()
        stop()
    end)
    
    scanBtn.MouseButton1Click:Connect(function()
        scan()
    end)
    
    -- DRAG
    local dragging = false
    local dragStart, startPos
    
    title.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
        end
    end)
    
    title.InputChanged:Connect(function(input)
        if dragging then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
    
    title.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    -- UPDATE STATUS
    RunService.RenderStepped:Connect(function()
        if running then
            status.Text = ("Running: %s"):format(phase)
        else
            status.Text = "Status: Ready"
        end
    end)
    
    gui.Parent = player:WaitForChild("PlayerGui")
    print("✅ UI loaded")
end

-- INIT
local ok, err = pcall(function()
    createUI()
end)

if not ok then
    warn("UI failed: " .. tostring(err))
    print("❌ UI creation failed. Check console.")
else
    print("📚 Library Auto loaded!")
    print("  Use the panel to start")
end
