-- CORE FUNCTIONS (REVISED)
-- ═══════════════════════════════════════════════

local function getHRP()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function isBook(obj)
    if not obj or not obj.Parent then return false end
    if not obj:IsA("MeshPart") then return false end
    if obj.MeshId ~= BOOK_MESH_ID then return false end
    if obj:IsDescendantOf(LocalPlayer.Character) then return false end
    return true
end

local function isShelf(obj)
    if not obj or not obj.Parent then return false end
    if obj.Name:match("^BookShelf%d+$") then
        return obj:IsA("MeshPart") or obj:IsA("BasePart")
    end
    if obj:IsA("MeshPart") and obj.MeshId then
        return SHELF_MESH_IDS[obj.MeshId] == true
    end
    return false
end

-- สร้าง FilterList อย่างปลอดภัย (ป้องกัน Character เป็น nil)
local function getSafeFilterList(obj)
    local list = {obj}
    local char = LocalPlayer.Character
    if char then
        table.insert(list, char)
    end
    return list
end

-- ✅ ตรวจสอบว่าชั้นว่างหรือไม่ (รวมหลายวิธี + pcall)
local function isShelfEmpty(shelf)
    local targetCF = shelf.CFrame * CFrame.new(0, Config.PlaceOffset, 0)
    local targetPos = targetCF.Position

    -- วิธี 1: เช็คจาก Cache ว่าเราเพิ่งใช้ชั้นนี้ไปหรือยัง
    local lastUsed = PlacedShelves[shelf]
    if lastUsed and (tick() - lastUsed) < SHELF_COOLDOWN then
        return false
    end

    -- วิธี 2: GetPartBoundsInRadius (มี pcall กัน crash)
    local success, parts = pcall(function()
        local params = OverlapParams.new()
        params.FilterDescendantsInstances = getSafeFilterList(shelf)
        params.FilterType = Enum.RaycastFilterType.Blacklist
        return Workspace:GetPartBoundsInRadius(targetPos, 3, params)
    end)

    if success and parts then
        for _, p in ipairs(parts) do
            if isBook(p) then
                return false
            end
        end
    else
        -- ถ้า spatial query พัง ให้ถือว่าว่างไปก่อน (fallback)
        warn("AutoShelf: GetPartBoundsInRadius failed for", shelf.Name)
    end

    return true
end

-- ✅ สแกนชั้นแบบมี Cache (ไม่สแกนซ้ำทุกวินาที)
local function scanShelves(forceRefresh)
    local now = tick()
    if not forceRefresh and ShelfCache and (now - ShelfCacheTime) < 5 then
        return ShelfCache
    end

    local hrp = getHRP()
    if not hrp then return {} end

    local list = {}
    local desc = Workspace:GetDescendants()
    local totalFound = 0

    for i, obj in ipairs(desc) do
        if isShelf(obj) then
            totalFound = totalFound + 1
            local d = (obj.Position - hrp.Position).Magnitude
            if d <= Config.ShelfRadius then
                -- Yield ทุก 500 อ็อบเจ็กต์ กันเกมค้าง
                if i % 500 == 0 then task.wait() end

                if isShelfEmpty(obj) then
                    table.insert(list, {shelf = obj, dist = d})
                end
            end
        end
    end

    table.sort(list, function(a, b) return a.dist < b.dist end)
    ShelfCache = list
    ShelfCacheTime = now

    print(string.format("📊 AutoShelf: เจอชั้นทั้งหมด %d | ว่าง %d | ระยะ %d", totalFound, #list, Config.ShelfRadius))
    return list
end

local function tweenBook(book, shelf)
    if not book or not shelf or not book.Parent then return false end
    if not shelf.Parent then return false end

    local targetCF = shelf.CFrame * CFrame.new(0, Config.PlaceOffset, 0) * CFrame.Angles(0, math.rad(90), 0)
    local dist = (book.Position - targetCF.Position).Magnitude
    local duration = math.max(0.3, dist / (20 * Config.Speed))

    book.Anchored = true
    book.CanCollide = false

    local tween = TweenService:Create(book, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {
        CFrame = targetCF
    })

    tween:Play()
    tween.Completed:Wait()

    book.Anchored = true
    return true
end

-- ═══════════════════════════════════════════════
-- MAIN LOOP (REVISED)
-- ═══════════════════════════════════════════════

local function mainLoop()
    while true do
        task.wait(0.5)
        if not Config.Enabled then
            isRunning = false
            continue
        end
        if isRunning then continue end

        isRunning = true
        local ok, err = pcall(function()
            local hrp = getHRP()
            if not hrp then
                UI.statusLabel.Text = "⏳ รอตัวละคร..."
                return
            end

            local books = scanBooks()
            local shelves = scanShelves()

            UI.bookCount.Text = "📖 หนังสือ: " .. #books
            UI.shelfCount.Text = "🗄️ ชั้นวางว่าง: " .. #shelves

            if #books > 0 and #shelves > 0 then
                UI.statusLabel.Text = string.format("📦 กำลังจัดเก็บ %d เล่ม (ชั้นว่าง %d)", #books, #shelves)
                UI.statusLabel.TextColor3 = Color3.fromRGB(255, 200, 100)

                for i, data in ipairs(books) do
                    if not Config.Enabled then break end
                    if not data.book.Parent then continue end

                    -- Rescan ถ้าชั้นหมด
                    if #shelves == 0 then
                        shelves = scanShelves(true) -- force refresh
                    end
                    if #shelves == 0 then
                        UI.statusLabel.Text = "⚠️ ชั้นวางเต็ม/หมดชั่วคราว!"
                        UI.statusLabel.TextColor3 = Color3.fromRGB(255, 150, 100)
                        break
                    end

                    local shelfData = shelves[1]
                    if not shelfData or not shelfData.shelf.Parent then
                        table.remove(shelves, 1)
                        continue
                    end

                    -- Double check ก่อนวาง (ป้องกันซ้ำ)
                    if not isShelfEmpty(shelfData.shelf) then
                        table.remove(shelves, 1)
                        continue
                    end

                    -- จองชั้นก่อน Tween (ป้องกันวางซ้ำถ้ามีหนังสือหลายเล่ม)
                    PlacedShelves[shelfData.shelf] = tick()

                    local success = tweenBook(data.book, shelfData.shelf)
                    if success then
                        UI.statusLabel.Text = string.format("✅ จัดเก็บเล่มที่ %d/%d สำเร็จ", i, #books)
                        task.wait(0.3)
                    else
                        -- ปลดจองถ้า Tween ล้มเหลว
                        PlacedShelves[shelfData.shelf] = nil
                    end

                    table.remove(shelves, 1)
                    task.wait(0.2)
                end

                UI.statusLabel.Text = "🟢 รอบนี้เสร็จสิ้น"
                UI.statusLabel.TextColor3 = Color3.fromRGB(100, 255, 150)
            else
                if #books == 0 then
                    UI.statusLabel.Text = "🔍 ไม่พบหนังสือในระยะ " .. Config.ScanRadius
                else
                    UI.statusLabel.Text = "⚠️ ไม่พบชั้นวางว่าง! (เจอชั้นทั้งหมด: 0 หรือเต็มหมด)"
                end
                UI.statusLabel.TextColor3 = Color3.fromRGB(255, 180, 100)
            end
        end)

        if not ok then
            warn("AutoShelf Loop Error:", err)
            UI.statusLabel.Text = "❌ Error: " .. tostring(err):sub(1, 50)
            UI.statusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
            task.wait(2)
        end

        isRunning = false
        task.wait(1)
    end
end

-- ล้าง Cache ชั้นที่ใช้แล้วทุก 60 วินาที (ให้ใช้ซ้ำได้ถ้าหนังสือหายไป)
task.spawn(function()
    while true do
        task.wait(SHELF_COOLDOWN)
        local count = 0
        for s, t in pairs(PlacedShelves) do
            if tick() - t >= SHELF_COOLDOWN then
                PlacedShelves[s] = nil
                count = count + 1
            end
        end
        if count > 0 then
            ShelfCache = nil -- บังคับ rescan
            print("AutoShelf: ล้างชั้นที่ใช้แล้ว", count, "ชั้น")
        end
    end
end)

