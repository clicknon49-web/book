local function setupSlider(track, handle, fill, label, configKey, min, max, prefix, isFloat)
    local draggingSlider = false
    local function update(x)
        local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local val = isFloat and (min + (max - min) * rel) or math.floor(min + (max - min) * rel)
        if isFloat then val = math.floor(val * 10) / 10 end
        Config[configKey] = val
        handle.Position = UDim2.new(rel, -8, 0.5, -8)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        label.Text = prefix .. tostring(val) .. (isFloat and "x" or "")
    end
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = true
        end
    end)
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            update(input.Position.X)
            draggingSlider = true
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = false
        end
    end)
    local initRel = (Config[configKey] - min) / (max - min)
    handle.Position = UDim2.new(initRel, -8, 0.5, -8)
    fill.Size = UDim2.new(initRel, 0, 1, 0)
end

setupSlider(UI.distFill.Parent, UI.distHandle, UI.distFill, UI.distLabel, "ScanRadius", 10, 200, "🔍 ระยะสแกนหนังสือ: ", false)
