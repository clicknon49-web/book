-- ==========================
-- CHARACTER HELPERS
-- ==========================
local function getHRP()
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid()
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChildOfClass("Humanoid")
end

-- ==========================
-- TARGET FINDER (Broad Search)
-- ==========================
local function findTargets()
    local targets = {}
    local hrp = getHRP()
    if not hrp then return targets end

    local rp = hrp.Position

    -- Scan everything in workspace
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local part = obj:IsA("BasePart") and obj or (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart"))
            if part then
                local d = (part.Position - rp).Magnitude
                if d <= CONFIG.Range then
                    local name = obj.Name:lower()
                    local score = 0

                    -- Keyword matching
                    local keywords = {
                        ["book"] = 10, ["note"] = 8, ["page"] = 8,
                        ["paper"] = 7, ["scroll"] = 7, ["diary"] = 6,
                        ["tome"] = 6, ["item"] = 5, ["collect"] = 9,
                        ["trash"] = 4, ["clean"] = 4, ["obj"] = 3,
                    }
                    for key, val in pairs(keywords) do
                        if name:find(key) then score = score + val end
                    end

                    -- Check interactables
                    local interactType = "none"
                    local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt")
                    local clicker = obj:IsA("BasePart") and obj:FindFirstChildWhichIsA("ClickDetector") or nil

                    if prompt then
                        score = score + 15
                        interactType = "prompt"
                    elseif clicker then
                        score = score + 12
                        interactType = "click"
                    end

                    -- Check if small (pickup-able)
                    if obj:IsA("BasePart") and obj.Size.Magnitude < 5 then
                        score = score + 3
                    end

                    if score > 0 then
                        table.insert(targets, {
                            obj = obj,
                            part = part,
                            dist = d,
                            score = score,
                            interact = interactType,
                            name = obj.Name
                        })
                    end
                end
            end
        end
    end

    -- Sort by score desc, then dist asc
    table.sort(targets, function(a, b)
        if a.score ~= b.score then return a.score > b.score end
        return a.dist < b.dist
    end)

    Debug.Log(("Found %d targets"):format(#targets))
    return targets
end

-- ==========================
-- INTERACTION SYSTEM
-- ==========================
local function interact(obj)
    if not obj then return false end

    -- Try ProximityPrompt first
    local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt")
    if prompt then
        local ok = pcall(function()
            if fireproximityprompt then
                fireproximityprompt(prompt)
            else
                prompt:RequestPrompt()
            end
        end)
        if ok then
            Debug.Log("Interacted via Prompt")
            return true
        end
    end

    -- Try ClickDetector
    if obj:IsA("BasePart") then
        local cd = obj:FindFirstChildWhichIsA("ClickDetector")
        if cd then
            local ok = pcall(function()
                if fireclickdetector then
                    fireclickdetector(cd)
                end
            end)
            if ok then
                Debug.Log("Interacted via ClickDetector")
                return true
            end
        end
    end

    -- Try Touch (move player close)
    local hrp = getHRP()
    if hrp then
        local part = obj:IsA("BasePart") and obj or obj.PrimaryPart
        if part then
            hrp.CFrame = CFrame.new(part.Position + Vector3.new(0, 2.5, 0))
            Debug.Log("Moved to target")
            return true
        end
    end

    return false
end

-- ==========================
-- COLLECTION LOGIC
-- ==========================
local function collect()
    local hrp = getHRP()
    local humanoid = getHumanoid()
    if not hrp or not humanoid then
        Debug.Warn("No character or humanoid")
        return
    end

    local targets = findTargets()
    if #targets == 0 then
        Debug.Log("No targets in range")
        return
    end

    local t = targets[1]
    Debug.Log(("Target: %s at %dm"):format(t.name, math.floor(t.dist)))

    if t.dist < 6 then
        -- Close enough - interact
        interact(t.obj)
    else
        -- Walk toward target
        local tp = t.part.Position
        tp = Vector3.new(tp.X, hrp.Position.Y, tp.Z)
        local dir = (tp - hrp.Position).Unit
        humanoid:Move(dir * CONFIG.MoveSpeed, true)
    end
end

-- ==========================
-- ESP SYSTEM
-- ==========================
local espObjects = {}

local function clearESP()
    for _, data in pairs(espObjects) do
        if data.billboard then data.billboard:Destroy() end
        if data.highlight then data.highlight:Destroy() end
    end
    espObjects = {}
end

local function refreshESP()
    clearESP()
    if not espEnabled then return end

    local targets = findTargets()
    for _, t in ipairs(targets) do
        local part = t.part

        -- Billboard
        local bb = Instance.new("BillboardGui")
        bb.Size = UDim2.new(0, 130, 0, 32)
        bb.StudsOffset = Vector3.new(0, 2.5, 0)
        bb.AlwaysOnTop = true
        bb.Adornee = part
        bb.Parent = part

        local bg = Instance.new("Frame")
        bg.Size = UDim2.new(1, 0, 1, 0)
        bg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        bg.BackgroundTransparency = 0.7
        bg.BorderSizePixel = 0
        bg.Parent = bb

        local c = Instance.new("UICorner")
        c.CornerScale = UDim2.new(0, 6)
        c.Parent = bg

        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, 0, 1, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = ("📚 %dm"):format(math.floor(t.dist))
        lbl.TextColor3 = CONFIG.ESPColor
        lbl.TextSize = 13
        lbl.Font = Enum.Font.GothamBold
        lbl.TextStrokeTransparency = 0
        lbl.Parent = bb

        -- Highlight
        local hl = Instance.new("Highlight")
        hl.FillColor = CONFIG.ESPColor
        hl.OutlineColor = CONFIG.ESPColor
        hl.FillTransparency = 0.7
        hl.OutlineTransparency = 0
        hl.Parent = part

        espObjects[part] = { billboard = bb, highlight = hl }

        -- Auto cleanup
        local conn
        conn = part.AncestryChanged:Connect(function()
            if not part:IsDescendantOf(game) then
                if espObjects[part] then
                    if espObjects[part].billboard then espObjects[part].billboard:Destroy() end
                    if espObjects[part].highlight then espObjects[part].highlight:Destroy() end
                    espObjects[part] = nil
                end
                conn:Disconnect()
            end
        end)
    end

    Debug.Log(("ESP refreshed: %d markers"):format(#targets))
end

