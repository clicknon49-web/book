local collectTimer = 0

RunService.RenderStepped:Connect(function(dt)
    -- Auto collect loop
    if autoCollecting then
        collectTimer = collectTimer + dt
        if collectTimer >= CONFIG.CollectDelay then
            collectTimer = 0
            collect()
        end
    end

    -- ESP refresh loop
    if espEnabled then
        espTimer = (espTimer or 0) + dt
        if espTimer >= 0.5 then
            espTimer = 0
            refreshESP()
        end
    end
end)

