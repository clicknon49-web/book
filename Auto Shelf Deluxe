-- ESP SYSTEM
-- ==========================
local espParts = {}

local function createBillboard(part, text)
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 120, 0, 30)
    bb.StudsOffset = Vector3.new(0, 2, 0)
    bb.AlwaysOnTop = true
    bb.Parent = part

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = CONFIG.HighlightColor
    label.TextSize = 12
    label.Font = Enum.Font.GothamBold
    label.TextStrokeTransparency = 0.5
    label.Parent = bb

    return bb
end

local function updateAllBillboards()
    for part, bb in pairs(espParts) do
        if part.Parent and bb then
            local label = bb:FindFirstChildWhichIsA("TextLabel")
            if label then
                local char = player.Character
                if char then
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local dist = math.floor((part.Position - hrp.Position).Magnitude)
                        label.Text = CONFIG.ShowDistance and ("📚 %dm"):format(dist) or "📚 Book"
                    end
                end
            end
        end
    end
end

local function startESP()
    stopESP()
    local books = findBooks()
    for _, book in ipairs(books) do
        if not espParts[book.part] then
            local bb = createBillboard(book.part, ("📚 %dm"):format(math.floor(book.distance)))
            espParts[book.part] = bb

            -- Highlight
            local highlight = Instance.new("Highlight")
            highlight.FillColor = CONFIG.HighlightColor
            highlight.OutlineColor = CONFIG.HighlightColor
            highlight.OutlineTransparency = 0
            highlight.FillTransparency = CONFIG.HighlightTransparency
            highlight.Parent = book.part

            espParts[book.part].__highlight = highlight

            -- Cleanup when part removed
            local conn
            conn = book.part.AncestryChanged:Connect(function()
                if not book.part:IsDescendantOf(game) then
                    if espParts[book.part] then
                        espParts[book.part]:Destroy()
                        if espParts[book.part].__highlight then
                            espParts[book.part].__highlight:Destroy()
                        end
                        espParts[book.part] = nil
                    end
                    conn:Disconnect()
                end
            end)
        end
    end
end

local function stopESP()
    for part, bb in pairs(espParts) do
        if bb then
            bb:Destroy()
        end
        if espParts[part].__highlight then
            espParts[part].__highlight:Destroy()
        end
    end
    espParts = {}
end

-- ==========================
-- AUTO COLLECTION
-- ==========================
local function collectBook(book)
    local char = player.Character
    if not char then return false end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    -- Try to walk to the book
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end

    local targetPos = book.part.Position
    targetPos = Vector3.new(targetPos.X, hrp.Position.Y, targetPos.Z)

    -- Move toward book
    local direction = (targetPos - hrp.Position).Unit
    humanoid:Move(direction * 16, true)

    return true
end

local function startCollection()
    stopCollection()

    if gui and gui.status then
        gui.status.Text = "Status: Collecting..."
        gui.status.TextColor3 = Color3.fromRGB(0, 255, 100)
    end

    collectionLoop = RunService.Heartbeat:Connect(function()
        if not CONFIG.AutoCollect then return end

        local char = player.Character
        if not char then return end
        if not char:FindFirstChild("HumanoidRootPart") then return end

        local books = findBooks()
        if #books == 0 then return end

        -- Collect nearest book
        local nearest = books[1]
        if nearest.distance < 5 then
            -- Close enough, interact if possible
            local proximityPrompt = nearest.part:FindFirstChildWhichIsA("ProximityPrompt")
            if proximityPrompt then
                fireproximityprompt(proximityPrompt)
            end

            -- Also try click detector
            local clickDetector = nearest.part:FindFirstChildWhichIsA("ClickDetector")
            if clickDetector then
                fireclickdetector(clickDetector)
            end

            -- Try touching
            local hrp = char:FindFirstChild("HumanoidRootPart")
            hrp.CFrame = CFrame.new(nearest.part.Position + Vector3.new(0, 3, 0))
        else
            -- Walk to it
            collectBook(nearest)
        end
    end)
end

local function stopCollection()
    if collectionLoop then
        collectionLoop:Disconnect()
        collectionLoop = nil
    end

    if gui and gui.status then
        gui.status.Text = "Status: Stopped"
        gui.status.TextColor3 = Color3.fromRGB(255, 150, 50)
    end
end

-- ==========================
-- HOTKEY SYSTEM
-- ==========================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end

    -- F key: Toggle auto collect
    if input.KeyCode == Enum.KeyCode.F then
        CONFIG.AutoCollect = not CONFIG.AutoCollect
        if CONFIG.AutoCollect then
            startCollection()
        else
            stopCollection()
        end
    end

    -- G key: Toggle ESP
    if input.KeyCode == Enum.KeyCode.G then
        CONFIG.ShowESP = not CONFIG.ShowESP
        if CONFIG.ShowESP then
            startESP()
        else
            stopESP()
        end
    end

    -- H key: Toggle UI
    if input.KeyCode == Enum.KeyCode.H then
        if gui then
            local mf = gui:FindFirstChild("MainFrame")
            if mf then
                mf.Visible = not mf.Visible
            end
        end
    end

    -- E key: Manual collect nearest
    if input.KeyCode == Enum.KeyCode.E then
        local books = findBooks()
        if #books > 0 then
            collectBook(books[1])
        end
    end
end)

