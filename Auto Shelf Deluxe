-- ==========================
local lastCollect = 0
RunService.RenderStepped:Connect(function(dt)
    if auto then
        lastCollect = lastCollect + dt
        if lastCollect >= CONFIG.CollectDelay then
            lastCollect = 0
            collect()
        end
    end
end)

-- ESP update
local espTimer = 0
RunService.RenderStepped:Connect(function(dt)
    if esp then
        espTimer = espTimer + dt
        if espTimer >= 0.5 then
            espTimer = 0
            refreshESP()
        end
    end
end)

-- Cleanup on respawn
Players.LocalPlayer.CharacterAdded:Connect(function()
    espParts = {}
    if esp then refreshESP() end
end)

