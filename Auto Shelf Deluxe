-- ==========================
-- CONFIG
-- ==========================
local CONFIG = {
    MoveSpeed = 16,
    InteractRange = 5,
    InteractDelay = 0.4,
    ESPColor = Color3.fromRGB(0, 255, 200),
    CollectedColor = Color3.fromRGB(100, 100, 100),
}

-- ==========================
-- STATE
-- ==========================
local State = {
    Running = false,
    Phase = "idle", -- idle, toBook, collect, toShelf, place
    CurrentBook = nil,
    CurrentShelf = nil,
    CollectedBooks = {},
    TotalBooks = 0,
    PlacedBooks = 0,
    LastBookPos = nil,
}

-- ==========================
-- HELPERS
-- ==========================
local function getHRP()
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid()
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChildOfClass("Humanoid")
end

local function getDistance(pos)
    local hrp = getHRP()
    if not hrp then return math.huge end
    return (hrp.Position - pos).Magnitude
end

-- ==========================
-- BOOK & SHELF SCANNER
-- ==========================
local Books = {}
local Shelves = {}

local function scanWorkspace()
    Books = {}
    Shelves = {}

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("MeshPart") then
            local name = obj.Name

            -- Book: มี _ตัวเลข ต่อท้าย และไม่ใช่ BookShelf
            if not name:find("BookShelf") and not name:find("Shelf") then
                local bookName, shelfNum = name:match("^(.+)_([%d]+)$")
                if bookName and shelfNum then
                    table.insert(Books, {
                        Part = obj,
                        Name = bookName,
                        ShelfNum = tonumber(shelfNum),
                        FullName = name,
                        Collected = false,
                        Placed = false,
                    })
                end
            end

            -- Shelf: ชื่อมี BookShelf
            if name:find("BookShelf") then
                local _, shelfNum = name:match("^(.+)_([%d]+)$")
                table.insert(Shelves, {
                    Part = obj,
                    Num = tonumber(shelfNum) or 0,
                    Name = name,
                })
            end
        end
    end

    -- เรียงหนังสือตามระยะ
    local hrp = getHRP()
    if hrp then
        local rp = hrp.Position
        table.sort(Books, function(a, b)
            local da = (a.Part.Position - rp).Magnitude
            local db = (b.Part.Position - rp).Magnitude
            return da < db
        end)
    end

    State.TotalBooks = #Books

    print(("📚 Scanned: %d books, %d shelves"):format(#Books, #Shelves))
    for i, b in ipairs(Books) do
        print(("  [%d] %s → Shelf %d"):format(i, b.Name, b.ShelfNum))
    end
end

local function findShelfForBook(book)
    for _, shelf in ipairs(Shelves) do
        if shelf.Num == book.ShelfNum then
            return shelf
        end
    end
    -- ถ้าไม่เจอ shelf ตรงเลข ให้ใช้ shelf ไหนก็ได้ที่ใกล้สุด
    if #Shelves > 0 then
        local hrp = getHRP()
        if hrp then
            local closest = Shelves[1]
            local closestDist = math.huge
            for _, s in ipairs(Shelves) do
                local d = (s.Part.Position - hrp.Position).Magnitude
                if d < closestDist then
                    closestDist = d
                    closest = s
                end
            end
            return closest
        end
    end
    return nil
end

local function getNextUncollectedBook()
    for _, b in ipairs(Books) do
        if not b.Collected and b.Part and b.Part.Parent then
            return b
        end
    end
    return nil
end

-- ==========================
-- MOVEMENT
-- ==========================
local function moveTo(pos, stopDist)
    stopDist = stopDist or 3
    local hrp = getHRP()
    local humanoid = getHumanoid()
    if not hrp or not humanoid then return false end

    local target = Vector3.new(pos.X, hrp.Position.Y, pos.Z)
    local dist = (target - hrp.Position).Magnitude

    if dist <= stopDist then
        humanoid:Move(Vector3.new(), true)
        return true
    end

    local dir = (target - hrp.Position).Unit
    humanoid:Move(dir * CONFIG.MoveSpeed, true)
    return false
end

-- ==========================
-- INTERACTION
-- ==========================
local function interact(obj)
    if not obj or not obj.Parent then return false end

    -- วิธีที่ 1: ProximityPrompt
    local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt")
    if prompt then
        local ok = pcall(function()
            if fireproximityprompt then
                fireproximityprompt(prompt)
            else
                prompt:RequestPrompt()
            end
        end)
        if ok then return true end
    end

    -- วิธีที่ 2: ClickDetector
    local cd = obj:FindFirstChildWhichIsA("ClickDetector")
    if cd then
        local ok = pcall(function()
            if fireclickdetector then
                fireclickdetector(cd)
            end
        end)
        if ok then return true end
    end

    -- วิธีที่ 3: Touch (เดินไปชน)
    -- จะทำใน movement loop อยู่แล้ว

    return false
end

-- ==========================
-- ESP
-- ==========================
local ESP = {}

local function clearESP()
    for _, e in pairs(ESP) do
        if e.Billboard then e.Billboard:Destroy() end
        if e.Highlight then e.Highlight:Destroy() end
    end
    ESP = {}
end

local function refreshESP()
    clearESP()

    for _, b in ipairs(Books) do
        if b.Part and b.Part.Parent then
            local color = CONFIG.ESPColor
            if b.Placed then
                color = Color3.fromRGB(50, 50, 50)
            elseif b.Collected then
                color = Color3.fromRGB(200, 150, 0)
            end

            local bb = Instance.new("BillboardGui")
            bb.Size = UDim2.new(0, 160, 0, 40)
            bb.StudsOffset = Vector3.new(0, 2.5, 0)
            bb.AlwaysOnTop = true
            bb.Parent = b.Part

            local bg = Instance.new("Frame")
            bg.Size = UDim2.new(1, 0, 1, 0)
            bg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            bg.BackgroundTransparency = 0.7
            bg.BorderSizePixel = 0
            bg.Parent = bb

            local c = Instance.new("UICorner")
            c.CornerScale = UDim2.new(0, 6)
            c.Parent = bg

            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, 0, 1, 0)
            lbl.BackgroundTransparency = 1
            lbl.Text = ("📚 %s\n📍 Shelf %d"):format(b.Name, b.ShelfNum)
            lbl.TextColor3 = color
            lbl.TextSize = 12
            lbl.Font = Enum.Font.GothamBold
            lbl.TextWrapped = true
            lbl.Parent = bb

            local hl = Instance.new("Highlight")
            hl.FillColor = color
            hl.OutlineColor = color
            hl.FillTransparency = 0.7
            hl.OutlineTransparency = 0
            hl.Parent = b.Part

            ESP[b.Part] = { Billboard = bb, Highlight = hl }
        end
    end

    -- ESP สำหรับชั้น
    for _, s in ipairs(Shelves) do
        if s.Part and s.Part.Parent then
            local bb = Instance.new("BillboardGui")
            bb.Size = UDim2.new(0, 100, 0, 28)
            bb.StudsOffset = Vector3.new(0, 3, 0)
            bb.AlwaysOnTop = true
            bb.Parent = s.Part

            local bg = Instance.new("Frame")
            bg.Size = UDim2.new(1, 0, 1, 0)
            bg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            bg.BackgroundTransparency = 0.7
            bg.BorderSizePixel = 0
            bg.Parent = bb

            local c = Instance.new("UICorner")
            c.CornerScale = UDim2.new(0, 6)
            c.Parent = bg

            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, 0, 1, 0)
            lbl.BackgroundTransparency = 1
            lbl.Text = ("📖 Shelf %d"):format(s.Num)
            lbl.TextColor3 = Color3.fromRGB(150, 100, 255)
            lbl.TextSize = 12
            lbl.Font = Enum.Font.GothamBold
            lbl.Parent = bb

            local hl = Instance.new("Highlight")
            hl.FillColor = Color3.fromRGB(150, 100, 255)
            hl.OutlineColor = Color3.fromRGB(150, 100, 255)
            hl.FillTransparency = 0.8
            hl.OutlineTransparency = 0
            hl.Parent = s.Part

            ESP[s.Part] = { Billboard = bb, Highlight = hl }
        end
    end
end

-- ==========================
-- MAIN LOOP
-- ==========================
local interactTimer = 0
local stuckTimer = 0
local lastDist = math.huge

RunService.RenderStepped:Connect(function(dt)
    if not State.Running then return end

    local hrp = getHRP()
    if not hrp then return end

    -- Phase: ไปหาหนังสือ
    if State.Phase == "toBook" then
        if not State.CurrentBook or not State.CurrentBook.Part or not State.CurrentBook.Part.Parent then
            -- หนังสือหายไปแล้ว ไปหาเล่มถัดไป
            State.CurrentBook = getNextUncollectedBook()
            if not State.CurrentBook then
                print("✅ All books collected!")
                State.Running = false
                State.Phase = "idle"
                return
            end
        end

        local bookPos = State.CurrentBook.Part.Position
        local arrived = moveTo(bookPos, CONFIG.InteractRange)

        -- ตรวจสอบว่าติดหรือไม่
        local dist = getDistance(bookPos)
        if dist < lastDist then
            stuckTimer = 0
        else
            stuckTimer = stuckTimer + dt
        end
        lastDist = dist

        if stuckTimer > 2 then
            -- ติด ให้กระโดด
            local humanoid = getHumanoid()
            if humanoid then
                humanoid.Jump = true
                stuckTimer = 0
            end
        end

        if arrived or dist < CONFIG.InteractRange then
            State.Phase = "collect"
            interactTimer = 0
            lastDist = math.huge
            stuckTimer = 0
        end

    -- Phase: เก็บหนังสือ
    elseif State.Phase == "collect" then
        if not State.CurrentBook or not State.CurrentBook.Part or not State.CurrentBook.Part.Parent then
            State.Phase = "toBook"
            return
        end

        interactTimer = interactTimer + dt
        if interactTimer >= CONFIG.InteractDelay then
            interactTimer = 0
            local success = interact(State.CurrentBook.Part)

            -- สมมติว่าเก็บสำเร็จ (หรือรอให้ part หาย)
            State.CurrentBook.Collected = true
            State.LastBookPos = State.CurrentBook.Part.Position
            State.Phase = "toShelf"
            State.CurrentShelf = findShelfForBook(State.CurrentBook)
            print(("✅ Collected: %s → Going to Shelf %d"):format(State.CurrentBook.Name, State.CurrentBook.ShelfNum))

            -- ซ่อน ESP หนังสือที่เก็บแล้ว
            if ESP[State.CurrentBook.Part] then
                if ESP[State.CurrentBook.Part].Highlight then
                    ESP[State.CurrentBook.Part].Highlight.FillColor = CONFIG.CollectedColor
                    ESP[State.CurrentBook.Part].Highlight.OutlineColor = CONFIG.CollectedColor
                end
            end
        end

    -- Phase: ไปหาชั้น
    elseif State.Phase == "toShelf" then
        if not State.CurrentShelf or not State.CurrentShelf.Part or not State.CurrentShelf.Part.Parent then
            print("❌ Shelf not found, finding next book...")
            State.Phase = "toBook"
            State.CurrentBook = getNextUncollectedBook()
            return
        end

        local shelfPos = State.CurrentShelf.Part.Position
        local arrived = moveTo(shelfPos, CONFIG.InteractRange)

        local dist = getDistance(shelfPos)
        if dist < lastDist then
            stuckTimer = 0
        else
            stuckTimer = stuckTimer + dt
        end
        lastDist = dist

        if stuckTimer > 2 then
            local humanoid = getHumanoid()
            if humanoid then
                humanoid.Jump = true
                stuckTimer = 0
            end
        end

        if arrived or dist < CONFIG.InteractRange then
            State.Phase = "place"
            interactTimer = 0
            lastDist = math.huge
            stuckTimer = 0
        end

    -- Phase: วางหนังสือบนชั้น
    elseif State.Phase == "place" then
        interactTimer = interactTimer + dt
        if interactTimer >= CONFIG.InteractDelay then
            interactTimer = 0

            if State.CurrentShelf and State.CurrentShelf.Part and State.CurrentShelf.Part.Parent then
                interact(State.CurrentShelf.Part)
            end

            if State.CurrentBook then
                State.CurrentBook.Placed = true
            end
            State.PlacedBooks = State.PlacedBooks + 1

            print(("✅ Placed: %s on Shelf %d (%d/%d)"):format(
                State.CurrentBook.Name,
                State.CurrentBook.ShelfNum,
                State.PlacedBooks,
                State.TotalBooks
            ))

            -- หาหนังสือเล่มถัดไป
            State.CurrentBook = getNextUncollectedBook()
            if State.CurrentBook then
                State.Phase = "toBook"
            else
                print("✅ All books placed! Done!")
                State.Running = false
                State.Phase = "idle"
            end

            lastDist = math.huge
            stuckTimer = 0
        end
    end
end)

-- ==========================
-- CONTROLS
-- ==========================
local function start()
    if State.Running then return end
    scanWorkspace()
    if #Books == 0 then
        print("❌ No books found!")
        return
    end
    State.Running = true
    State.Phase = "toBook"
    State.PlacedBooks = 0
    State.CurrentBook = getNextUncollectedBook()
    refreshESP()
    print("🚀 Auto collector started!")
end

local function stop()
    State.Running = false
    State.Phase = "idle"
    local humanoid = getHumanoid()
    if humanoid then
        humanoid:Move(Vector3.new(), true)
    end
    print("⏹️ Stopped")
end

local function step()
    scanWorkspace()
    local b = getNextUncollectedBook()
    if b then
        State.CurrentBook = b
        State.Phase = "toBook"
        State.Running = true
        print(("📖 Stepping to: %s"):format(b.Name))
    else
        print("✅ No more books to collect")
    end
end

