-- ═══════════════════════════════════════════════
-- CORE FUNCTIONS (JSON-FIXED)
-- ═══════════════════════════════════════════════

local function getHRP()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function isBook(obj)
    if not obj or not obj.Parent then return false end
    if not obj:IsA("MeshPart") then return false end
    if obj.MeshId ~= BOOK_MESH_ID then return false end
    if obj:IsDescendantOf(LocalPlayer.Character) then return false end
    return true
end

-- ✅ แก้ไข: รองรับชื่อ BookShelf10/13/15 + MeshId
local function isShelf(obj)
    if not obj or not obj.Parent then return false end
    if not (obj:IsA("MeshPart") or obj:IsA("BasePart")) then return false end
    
    -- เช็คชื่อ
    if obj.Name:match("^BookShelf%d+$") then
        return true
    end
    
    -- เช็ค MeshId สำรอง
    if obj:IsA("MeshPart") and obj.MeshId then
        return SHELF_MESH_IDS[obj.MeshId] == true
    end
    
    return false
end

local function scanBooks()
    local list = {}
    local hrp = getHRP()
    if not hrp then return list end
    for _, obj in pairs(Workspace:GetDescendants()) do
        if isBook(obj) then
            local d = (obj.Position - hrp.Position).Magnitude
            if d <= Config.ScanRadius then
                table.insert(list, {book = obj, dist = d})
            end
        end
    end
    table.sort(list, function(a, b) return a.dist < b.dist end)
    return list
end

-- ✅ แก้ไขหลัก: ค้นหาชั้นวางจาก Folder "BookShelves" โดยตรง + ไม่ใช้ GetPartBoundsInRadius
local function scanShelves()
    local list = {}
    local hrp = getHRP()
    if not hrp then return list end

    local shelfFolder = Workspace:FindFirstChild("BookShelves (5008Books)") 
        or Workspace:FindFirstChild("BookShelves")
    
    local objectsToScan = {}
    
    if shelfFolder then
        -- วนลูปแบบเจาะจงใน Folder ชั้นวาง (เร็วกว่า GetDescendants ทั้ง Workspace)
        for _, categoryFolder in pairs(shelfFolder:GetChildren()) do
            if categoryFolder:IsA("Folder") then
                for _, obj in pairs(categoryFolder:GetChildren()) do
                    if isShelf(obj) then
                        table.insert(objectsToScan, obj)
                    end
                end
            end
        end
        if Config.Debug then
            print("📁 พบ Folder ชั้นวาง:", shelfFolder.Name, "| สแกนชั้น:", #objectsToScan)
        end
    else
        -- Fallback: ใช้ GetDescendants ถ้าไม่เจอ Folder
        for _, obj in pairs(Workspace:GetDescendants()) do
            if isShelf(obj) then
                table.insert(objectsToScan, obj)
            end
        end
        if Config.Debug then
            print("⚠️ ไม่พบ Folder BookShelves, ใช้ GetDescendants | ชั้นทั้งหมดในแมพ:", #objectsToScan)
        end
    end

    for _, obj in pairs(objectsToScan) do
        local d = (obj.Position - hrp.Position).Magnitude
        if d <= Config.ShelfRadius then
            -- ✅ ไม่ใช้ GetPartBoundsInRadius อีกต่อไป (เพราะมักมีบั๊ก)
            -- ถ้าต้องการเช็คว่างจริงๆ ให้ดูจาก Config.SkipOccupiedCheck
            local isEmpty = true
            
            if not Config.SkipOccupiedCheck then
                -- วิธีเช็คแบบง่าย: ดูว่ามีหนังสืออยู่ใน children ของชั้นหรือไม่
                -- (บางแมพหนังสือจะเป็น children ของชั้น)
                for _, child in pairs(obj:GetChildren()) do
                    if isBook(child) then
                        isEmpty = false
                        break
                    end
                end
            end
            
            if isEmpty then
                table.insert(list, {shelf = obj, dist = d})
            end
        end
    end
    
    table.sort(list, function(a, b) return a.dist < b.dist end)
    return list
end

local function getPlaceOffset(shelf)
    if Config.PlaceOffset then
        return Config.PlaceOffset
    end
    -- คำนวณอัตโนมัติจากขนาดชั้น (จาก JSON ชั้นสูง ~11.25)
    if shelf and shelf:IsA("BasePart") then
        return (shelf.Size.Y / 2) + 1.5
    end
    return 6 -- default ถ้าหาขนาดไม่เจอ
end

local function tweenBook(book, shelf)
    if not book or not shelf or not book.Parent then return false end
    if not shelf.Parent then return false end

    local offset = getPlaceOffset(shelf)
    local targetCF = shelf.CFrame * CFrame.new(0, offset, 0) * CFrame.Angles(0, math.rad(90), 0)
    local dist = (book.Position - targetCF.Position).Magnitude
    local duration = math.max(0.3, dist / (20 * Config.Speed))

    book.Anchored = true
    book.CanCollide = false

    local tween = TweenService:Create(book, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {
        CFrame = targetCF
    })

    tween:Play()
    tween.Completed:Wait()

    book.Anchored = true
    return true
end

