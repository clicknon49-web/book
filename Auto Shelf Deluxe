-- ==========================
-- COLLECTIBLE FINDER
-- ==========================
local function getHRP()
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid()
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChildOfClass("Humanoid")
end

local function findTargets()
    local targets = {}
    local hrp = getHRP()
    if not hrp then return targets end

    local rp = hrp.Position

    -- Scan ALL descendants - broad search
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local d = (obj.Position - rp).Magnitude
            if d <= CONFIG.Range then
                local lname = obj.Name:lower()
                local score = 0

                -- Score based on name
                if lname:find("book") then score = score + 10 end
                if lname:find("note") then score = score + 8 end
                if lname:find("page") then score = score + 8 end
                if lname:find("paper") then score = score + 7 end
                if lname:find("item") then score = score + 5 end
                if lname:find("collect") then score = score + 9 end
                if lname:find("trash") then score = score + 6 end
                if lname:find("clean") then score = score + 6 end
                if lname:find("obj") then score = score + 4 end

                -- Check for interactables
                if obj:FindFirstChildWhichIsA("ProximityPrompt") then score = score + 15 end
                if obj:FindFirstChildWhichIsA("ClickDetector") then score = score + 12 end

                -- Check if it's small (likely a pickup)
                if obj.Size.Magnitude < 5 then score = score + 3 end

                if score > 0 then
                    table.insert(targets, { part = obj, dist = d, score = score })
                end
            end
        elseif obj:IsA("Model") then
            local p = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
            if p then
                local d = (p.Position - rp).Magnitude
                if d <= CONFIG.Range then
                    local lname = obj.Name:lower()
                    local score = 0
                    if lname:find("book") then score = score + 10 end
                    if lname:find("collect") then score = score + 9 end
                    if lname:find("item") then score = score + 5 end
                    if score > 0 then
                        table.insert(targets, { part = p, dist = d, score = score, model = obj })
                    end
                end
            end
        end
    end

    -- Sort by score then distance
    table.sort(targets, function(a, b)
        if a.score ~= b.score then return a.score > b.score end
        return a.dist < b.dist
    end)

    return targets
end

-- ==========================
-- COLLECTION
-- ==========================
local function interact(obj)
    -- Try ProximityPrompt
    local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt")
    if prompt then
        local s = pcall(function()
            if fireproximityprompt then
                fireproximityprompt(prompt)
            else
                prompt:RequestPrompt()
            end
        end)
        if s then return true end
    end

    -- Try ClickDetector
    local cd = obj:FindFirstChildWhichIsA("ClickDetector")
    if cd then
        local s = pcall(function()
            if fireclickdetector then
                fireclickdetector(cd)
            end
        end)
        if s then return true end
    end

    return false
end

local function collect()
    local hrp = getHRP()
    local humanoid = getHumanoid()
    if not hrp or not humanoid then return end

    local targets = findTargets()
    if #targets == 0 then return end

    local t = targets[1]

    if t.dist < 5 then
        -- Close enough - interact
        interact(t.part)

        -- Also try touching
        hrp.CFrame = CFrame.new(t.part.Position + Vector3.new(0, 2, 0))

        -- Try model interaction
        if t.model then
            interact(t.model)
        end
    else
        -- Move toward target
        local tp = t.part.Position
        tp = Vector3.new(tp.X, hrp.Position.Y, tp.Z)
        local dir = (tp - hrp.Position).Unit
        humanoid:Move(dir * CONFIG.Speed, true)
    end
end

-- ==========================
-- ESP
-- ==========================
local espParts = {}

local function refreshESP()
    -- Clear
    for _, data in pairs(espParts) do
        if data.bb then data.bb:Destroy() end
        if data.hl then data.hl:Destroy() end
    end
    espParts = {}

    local targets = findTargets()
    for _, t in ipairs(targets) do
        local bb = Instance.new("BillboardGui")
        bb.Size = UDim2.new(0, 120, 0, 30)
        bb.StudsOffset = Vector3.new(0, 2, 0)
        bb.AlwaysOnTop = true
        bb.Parent = t.part

        local bg = Instance.new("Frame")
        bg.Size = UDim2.new(1, 0, 1, 0)
        bg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        bg.BackgroundTransparency = 0.6
        bg.BorderSizePixel = 0
        bg.Parent = bb

        local c = Instance.new("UICorner")
        c.CornerScale = UDim2.new(0, 6)
        c.Parent = bg

        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, 0, 1, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = ("📚 %dm"):format(math.floor(t.dist))
        lbl.TextColor3 = Color3.fromRGB(0, 255, 200)
        lbl.TextSize = 13
        lbl.Font = Enum.Font.GothamBold
        lbl.Parent = bb

        local hl = Instance.new("Highlight")
        hl.FillColor = Color3.fromRGB(0, 255, 200)
        hl.OutlineColor = Color3.fromRGB(0, 255, 200)
        hl.FillTransparency = 0.6
        hl.OutlineTransparency = 0
        hl.Parent = t.part

        espParts[t.part] = { bb = bb, hl = hl }

        -- Cleanup
        local conn
        conn = t.part.AncestryChanged:Connect(function()
            if not t.part:IsDescendantOf(game) then
                if espParts[t.part] then
                    if espParts[t.part].bb then espParts[t.part].bb:Destroy() end
                    if espParts[t.part].hl then espParts[t.part].hl:Destroy() end
                    espParts[t.part] = nil
                end
                conn:Disconnect()
            end
        end)
    end
end

