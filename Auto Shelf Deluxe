-- ═══════════════════════════════════════════════

local function mainLoop()
    while true do
        task.wait(0.5)
        if not Config.Enabled then isRunning = false; continue end
        if isRunning then continue end

        isRunning = true
        local hrp = getHRP()
        if not hrp then 
            isRunning = false
            if Config.Debug then print("❌ ไม่พบ HRP") end
            continue 
        end

        local books = scanBooks()
        local shelves = scanShelves()

        UI.bookCount.Text = "📖 หนังสือ: " .. #books
        UI.shelfCount.Text = "🗄️ ชั้นวางว่าง: " .. #shelves

        if Config.Debug then
            print(string.format("📊 สแกน: หนังสือ %d เล่ม | ชั้นวาง %d ชิ้น (ระยะ %d)", 
                #books, #shelves, Config.ShelfRadius))
        end

        if #books > 0 and #shelves > 0 then
            UI.statusLabel.Text = "📦 กำลังจัดเก็บ " .. #books .. " เล่ม..."
            UI.statusLabel.TextColor3 = Color3.fromRGB(255, 200, 100)

            for i, data in ipairs(books) do
                if not Config.Enabled then break end
                if not data.book.Parent then continue end

                if #shelves == 0 then shelves = scanShelves() end
                if #shelves == 0 then 
                    UI.statusLabel.Text = "⚠️ ชั้นวางเต็มหมดแล้ว!"
                    break 
                end

                local shelfData = shelves[1]
                if not shelfData or not shelfData.shelf.Parent then
                    table.remove(shelves, 1)
                    continue
                end

                -- Double check ก่อนวาง (แบบง่าย)
                local stillEmpty = true
                if not Config.SkipOccupiedCheck then
                    for _, child in pairs(shelfData.shelf:GetChildren()) do
                        if isBook(child) then 
                            stillEmpty = false
                            break 
                        end
                    end
                end

                if stillEmpty then
                    local ok = tweenBook(data.book, shelfData.shelf)
                    if ok then
                        UI.statusLabel.Text = "✅ จัดเก็บเล่มที่ " .. i .. " สำเร็จ"
                        if Config.Debug then
                            print("✅ วางหนังสือบน", shelfData.shelf.Name, "ที่", tostring(shelfData.shelf.Position))
                        end
                        task.wait(0.3)
                        table.remove(shelves, 1)
                    end
                else
                    if Config.Debug then print("⚠️ ชั้น", shelfData.shelf.Name, "มีหนังสือแล้ว ข้าม") end
                    table.remove(shelves, 1)
                end
                task.wait(0.2)
            end

            UI.statusLabel.Text = "🟢 รอบนี้เสร็จสิ้น"
            UI.statusLabel.TextColor3 = Color3.fromRGB(100, 255, 150)
        else
            if #books == 0 then
                UI.statusLabel.Text = "🔍 ไม่พบหนังสือในระยะ " .. Config.ScanRadius
            else
                UI.statusLabel.Text = "⚠️ ไม่พบชั้นวางว่าง! (เจอชั้นทั้งหมด: 0)"
            end
            UI.statusLabel.TextColor3 = Color3.fromRGB(255, 180, 100)
        end

        isRunning = false
        task.wait(1)
    end
end

