local function safeFirePrompt(prompt)
    local success, err = pcall(function()
        if fireproximityprompt then
            fireproximityprompt(prompt)
        else
            -- Fallback: simulate interaction
            fireclickdetector(prompt)
        end
    end)
    return success
end

local function safeFireClick(cd)
    local success = pcall(function()
        if fireclickdetector then
            fireclickdetector(cd)
        end
    end)
    return success
end

-- ==========================
-- BOOK DETECTION
-- ==========================
local function getCharacterRoot()
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid()
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChildOfClass("Humanoid")
end

local function findBooks()
    local books = {}
    local hrp = getCharacterRoot()
    if not hrp then return books end

    local rootPos = hrp.Position

    for _, obj in ipairs(workspace:GetDescendants()) do
        local name = obj.Name:lower()
        local isBook = name:find("book") or name:find("note") or name:find("page") 
                     or name:find("scroll") or name:find("diary") or name:find("tome")
                     or name:find("collect")

        if isBook and obj:IsA("BasePart") then
            local dist = (obj.Position - rootPos).Magnitude
            if dist <= CONFIG.CollectionRadius then
                table.insert(books, { part = obj, distance = dist })
            end
        end
    end

    -- Check models
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local lname = obj.Name:lower()
            if lname:find("book") or lname:find("collect") then
                local primary = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                if primary then
                    local dist = (primary.Position - rootPos).Magnitude
                    if dist <= CONFIG.CollectionRadius then
                        local exists = false
                        for _, b in ipairs(books) do
                            if b.part == primary then exists = true break end
                        end
                        if not exists then
                            table.insert(books, { part = primary, distance = dist, model = obj })
                        end
                    end
                end
            end
        end
    end

    table.sort(books, function(a, b) return a.distance < b.distance end)
    return books
end

