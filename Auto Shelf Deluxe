        label.Text = labelText
        label.TextColor3 = Color3.fromRGB(200, 200, 200)
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Font = Enum.Font.Gotham
        label.TextSize = 14
        label.Parent = frame

        local track = Instance.new("Frame")
        track.Size = UDim2.new(1, 0, 0, 8)
        track.Position = UDim2.new(0, 0, 0, 32)
        track.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
        track.BorderSizePixel = 0
        track.Parent = frame
        Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

        local fill = Instance.new("Frame")
        fill.Size = UDim2.new(0.25, 0, 1, 0)
        fill.BackgroundColor3 = defaultColor or Color3.fromRGB(80, 160, 255)
        fill.BorderSizePixel = 0
        fill.Parent = track
        Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

        local handle = Instance.new("Frame")
        handle.Size = UDim2.new(0, 16, 0, 16)
        handle.Position = UDim2.new(0.25, -8, 0.5, -8)
        handle.BackgroundColor3 = defaultColor and defaultColor:Lerp(Color3.new(1,1,1), 0.3) or Color3.fromRGB(120, 190, 255)
        handle.BorderSizePixel = 0
        handle.Parent = track
        Instance.new("UICorner", handle).CornerRadius = UDim.new(1, 0)

        local draggingSlider = false

        local function update(x)
            local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            local val = isFloat and (min + (max - min) * rel) or math.floor(min + (max - min) * rel)
            if isFloat then val = math.floor(val * 10) / 10 end

            Config[configKey] = val
            handle.Position = UDim2.new(rel, -8, 0.5, -8)
            fill.Size = UDim2.new(rel, 0, 1, 0)
            label.Text = prefix .. tostring(val) .. (isFloat and "x" or "")
        end

        handle.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                draggingSlider = true
            end
        end)
        track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                update(input.Position.X)
                draggingSlider = true
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                update(input.Position.X)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                draggingSlider = false
            end
        end)

        local initRel = (Config[configKey] - min) / (max - min)
        handle.Position = UDim2.new(initRel, -8, 0.5, -8)
        fill.Size = UDim2.new(initRel, 0, 1, 0)

        return label
    end

    makeSlider(content, "🔍 ระยะสแกนหนังสือ: 50", "ScanRadius", 10, 200, "🔍 ระยะสแกนหนังสือ: ", false, Color3.fromRGB(80, 160, 255))
