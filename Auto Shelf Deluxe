-- ==========================
-- BOOK DETECTION
-- ==========================
local function findBooks()
    local books = {}
    local char = player.Character
    if not char then return books end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return books end

    local rootPos = hrp.Position

    -- Search in workspace for book-like parts/models
    for _, obj in ipairs(workspace:GetDescendants()) do
        local name = obj.Name:lower()
        local isBook = name:find("book") or name:find("note") or name:find("page") or name:find("scroll")

        if isBook and obj:IsA("BasePart") then
            local dist = (obj.Position - rootPos).Magnitude
            if dist <= CONFIG.CollectionRadius then
                table.insert(books, { part = obj, distance = dist })
            end
        end
    end

    -- Also check for models with "Book" in name
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and (obj.Name:lower():find("book") or obj.Name:lower():find("collect")) then
            local primary = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
            if primary then
                local dist = (primary.Position - rootPos).Magnitude
                if dist <= CONFIG.CollectionRadius then
                    local exists = false
                    for _, b in ipairs(books) do
                        if b.part == primary then exists = true break end
                    end
                    if not exists then
                        table.insert(books, { part = primary, distance = dist, model = obj })
                    end
                end
            end
        end
    end

    table.sort(books, function(a, b) return a.distance < b.distance end)
    return books
end

