local function createESP(part, dist)
    -- Remove old
    if espParts[part] then
        if espParts[part].bb then espParts[part].bb:Destroy() end
        if espParts[part].hl then espParts[part].hl:Destroy() end
    end

    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 140, 0, 36)
    bb.StudsOffset = Vector3.new(0, 2.5, 0)
    bb.AlwaysOnTop = true
    bb.Parent = part

    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(1, 0, 1, 0)
    bg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    bg.BackgroundTransparency = 0.5
    bg.BorderSizePixel = 0
    bg.Parent = bb

    local corner = Instance.new("UICorner")
    corner.CornerScale = UDim2.new(0, 8)
    corner.Parent = bg

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = CONFIG.ShowDistance and ("📚 %dm"):format(math.floor(dist)) or "📚 Book"
    label.TextColor3 = CONFIG.HighlightColor
    label.TextSize = 14
    label.Font = Enum.Font.GothamBold
    label.TextStrokeTransparency = 0
    label.Parent = bb

    local hl = Instance.new("Highlight")
    hl.FillColor = CONFIG.HighlightColor
    hl.OutlineColor = CONFIG.HighlightColor
    hl.OutlineTransparency = 0
    hl.FillTransparency = CONFIG.HighlightTransparency
    hl.Parent = part

    espParts[part] = { bb = bb, hl = hl }

    -- Cleanup
    local conn
    conn = part.AncestryChanged:Connect(function()
        if not part:IsDescendantOf(game) then
            if espParts[part] then
                if espParts[part].bb then espParts[part].bb:Destroy() end
                if espParts[part].hl then espParts[part].hl:Destroy() end
                espParts[part] = nil
            end
            conn:Disconnect()
        end
    end)
end

local function refreshESP()
    -- Clear old
    for part, data in pairs(espParts) do
        if data.bb then data.bb:Destroy() end
        if data.hl then data.hl:Destroy() end
    end
    espParts = {}

    if not CONFIG.ShowESP then return end

    local books = findBooks()
    for _, book in ipairs(books) do
        createESP(book.part, book.distance)
    end
end

local function updateESPLabels()
    for part, data in pairs(espParts) do
        if data.bb and part.Parent then
            local label = data.bb:FindFirstChildWhichIsA("TextLabel")
            if label then
                local dist = (part.Position - (getCharacterRoot() and getCharacterRoot().Position or Vector3.new())).Magnitude
                label.Text = CONFIG.ShowDistance and ("📚 %dm"):format(math.floor(dist)) or "📚 Book"
            end
        end
    end
end

-- ==========================
-- COLLECTION LOGIC
-- ==========================
local function collectNearest()
    local hrp = getCharacterRoot()
    local humanoid = getHumanoid()
    if not hrp or not humanoid then return false end

    local books = findBooks()
    if #books == 0 then return false end

    local nearest = books[1]

    if nearest.distance < 5 then
        -- Interact
        local prompt = nearest.part:FindFirstChildWhichIsA("ProximityPrompt")
        if prompt then safeFirePrompt(prompt) end

        local cd = nearest.part:FindFirstChildWhichIsA("ClickDetector")
        if cd then safeFireClick(cd) end

        -- Teleport close
        hrp.CFrame = CFrame.new(nearest.part.Position + Vector3.new(0, 3, 0))
        return true
    else
        -- Walk toward
        local target = nearest.part.Position
        target = Vector3.new(target.X, hrp.Position.Y, target.Z)
        local dir = (target - hrp.Position).Unit
        humanoid:Move(dir * 16, true)
        return true
    end
end

local function startCollection()
    stopCollection()
    CONFIG.AutoCollect = true
    updateStatus("🟢 Collecting...", Color3.fromRGB(0, 255, 100))
    updateToggleLabels()

    collectionLoop = RunService.Heartbeat:Connect(function()
        if not CONFIG.AutoCollect then return end
        collectNearest()
    end)
end

local function stopCollection()
    CONFIG.AutoCollect = false
    if collectionLoop then
        collectionLoop:Disconnect()
        collectionLoop = nil
    end
    updateStatus("🟡 Stopped", Color3.fromRGB(255, 180, 50))
    updateToggleLabels()
end

local function toggleCollection()
    if CONFIG.AutoCollect then
        stopCollection()
    else
        startCollection()
    end
end

local function toggleESP()
    CONFIG.ShowESP = not CONFIG.ShowESP
    if CONFIG.ShowESP then
        refreshESP()
    else
        for part, data in pairs(espParts) do
            if data.bb then data.bb:Destroy() end
            if data.hl then data.hl:Destroy() end
        end
        espParts = {}
    end
    updateToggleLabels()
end

